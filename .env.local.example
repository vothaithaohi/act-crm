# ==============================================================================
# ACT ACADEMY MINI CRM - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.local)
# Kiến trúc: Next.js + Supabase + Anthropic Claude + Meta Ads API + Vercel
# ==============================================================================

# 1. SUPABASE DATABASE & AUTH & STORAGE (Hạ tầng miễn phí $0)
# Lấy từ Project Settings -> API trên dashboard https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. META ADS WEBHOOK & GRAPH API (Tiếp nhận Lead Facebook/Instagram thời gian thực)
# META_VERIFY_TOKEN: Token bí mật do bạn tự đặt trên Meta App Dashboard (Webhooks -> Leadgen)
META_VERIFY_TOKEN=act_secret_verify_token_2026

# META_PAGE_ACCESS_TOKEN: Token quyền Page có permission 'leads_retrieval' & 'pages_show_list'
META_PAGE_ACCESS_TOKEN=EAAG...your_long_lived_meta_page_access_token_here...

# 3. ANTHROPIC CLAUDE AI SDK (Báo cáo Phân tích Tối ưu Ads & Tài chính CFO)
# Model sử dụng: claude-3-5-sonnet-20241022 hoặc claude-3-5-haiku-20241022
# Lấy từ Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...your_anthropic_api_key_here...
